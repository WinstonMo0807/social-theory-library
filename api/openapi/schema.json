                                "format": "uri",
                                "maxLength": 1000
                            },
                            {
                                "type": "string",
                                "maxLength": 0
                            }
                        ]
                    },
                    "fields": {
                        "type": "object",
                        "additionalProperties": {}
                    }
                },
                "required": [
                    "fields",
                    "source_label"
                ]
            },
