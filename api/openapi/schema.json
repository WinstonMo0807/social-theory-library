                "enum": [
                    "unchanged",
                    "added",
                    "removed",
                    "changed"
                ],
                "type": "string",
                "description": "* `unchanged` - unchanged\n* `added` - added\n* `removed` - removed\n* `changed` - changed"
            },
            "DocumentTypeEnum": {
                "enum": [
                    "book",
                    "journal_article",
                    "journal_issue",
                    "thesis",
                    "report"
                ],
                "type": "string",
                "description": "* `book` - 图书\n* `journal_article` - 期刊论文\n* `journal_issue` - 整期期刊\n* `thesis` - 学位论文\n* `report` - 研究报告"
            },
            "MetadataDecisionActionEnum": {
                "enum": [
                    "reject",
                    "reopen"
                ],
                "type": "string",
                "description": "* `reject` - reject\n* `reopen` - reopen"
            },
