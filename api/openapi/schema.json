            "CatalogingCandidateDecisionRequest": {
                "type": "object",
                "properties": {
                    "action": {
                        "$ref": "#/components/schemas/CatalogingCandidateDecisionActionEnum"
                    },
                    "target_type": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                    },
                    "target_id": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true
                    },
                    "confirm_identity": {
                        "type": "boolean",
                        "default": false
                    },
                    "reason": {
                        "type": "string",
                        "default": "",
                        "maxLength": 1000
                    }
                },
                "required": [
                    "action",
                    "target_type"
                ]
            },
            "CatalogingMetadataImportRequest": {
                "type": "object",
                "properties": {
                    "source_label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                    },
