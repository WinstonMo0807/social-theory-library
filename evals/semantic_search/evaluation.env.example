# Docker Compose service credentials. Copy this file outside Git or pass it
# with --env-file. Values below are placeholders, not production credentials.
EVALUATION_POSTGRES_DB=library_evaluation
EVALUATION_POSTGRES_USER=library_evaluation
EVALUATION_POSTGRES_PASSWORD=replace-with-a-local-evaluation-password
EVALUATION_POSTGRES_PORT=55432

EVALUATION_SOURCE_POSTGRES_DB=library_evaluation_source
EVALUATION_SOURCE_POSTGRES_USER=library_evaluation_source
EVALUATION_SOURCE_POSTGRES_PASSWORD=replace-with-a-separate-source-copy-password
EVALUATION_SOURCE_POSTGRES_PORT=55433

EVALUATION_MEILISEARCH_MASTER_KEY=replace-with-a-local-evaluation-master-key
EVALUATION_MEILISEARCH_PORT=57700
EVALUATION_MODEL_CACHE=./data/evaluation/models
EVALUATION_HF_HUB_OFFLINE=1

# Environment used by manage.py while connected to the sanitized target.
DATABASE_URL=postgresql://library_evaluation:replace-with-a-local-evaluation-password@127.0.0.1:55432/library_evaluation
MEILISEARCH_URL=http://127.0.0.1:57700
MEILISEARCH_MASTER_KEY=replace-with-a-local-evaluation-master-key
SEMANTIC_SEARCH_EVALUATION_MODE=true
SEMANTIC_SEARCH_EVALUATION_DATABASE_NAME=library_evaluation
SEMANTIC_SEARCH_EVALUATION_MEILISEARCH_URL=http://127.0.0.1:57700
SEMANTIC_SEARCH_V2_ENABLED=false
SEMANTIC_SEARCH_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_SEARCH_OFFLINE_MODE=true
