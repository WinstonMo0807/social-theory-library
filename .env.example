# Copy this file to .env for local development. Never commit the copied file.

# Django and application security
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
PRIVATE_DATA_ENCRYPTION_KEY=
INTERNAL_API_TOKEN=replace-with-a-random-internal-service-token
TZ=Asia/Hong_Kong

# Database, cache and queues
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_IMAGE=postgres:16-alpine
DATABASE_URL=postgresql://library:replace-with-a-strong-database-password@postgres:5432/library
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=
CELERY_TASK_IGNORE_RESULT=true
CELERY_TASK_STORE_ERRORS_EVEN_IF_IGNORED=false
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
PROCESS_INGESTION_INLINE=false
INGESTION_TASK_QUEUE=ingestion
SEARCH_EVALUATION_TASK_QUEUE=celery

# Images and service addresses
LIBRARY_API_IMAGE=social-theory-library-api:local
LIBRARY_WEB_IMAGE=social-theory-library-web:local
MEILISEARCH_IMAGE=getmeili/meilisearch:v1.37
API_PORT=8000
WEB_PORT=3000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
BROWSER_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://api:8000/api
ALLOW_DEMO_FALLBACK=false

# Public and LAN entry points
LIBRARY_DOMAIN=library.example.com
LIBRARY_OWNER_EMAIL=owner@example.com
LAN_HOST=192.0.2.10
LAN_PROXY_TOKEN=replace-with-a-random-lan-proxy-token
LAN_HTTP_TRUSTED_ORIGINS=http://192.0.2.10:3000
EDGE_BIND_IP=127.0.0.1
EDGE_PORT=8080
LAN_ADMIN_PORT=3000
LAN_LEGACY_PORT=18080
PUBLIC_ROBOTS_HEADER=noindex, nofollow, noarchive
PUBLIC_HSTS_HEADER=max-age=86400
CLOUDFLARE_TUNNEL_PROTOCOL=auto
CLOUDFLARE_TUNNEL_TOKEN=

# NAS and file handling
NAS_HOST_ROOT=./data
NAS_LIBRARY_ROOT=/data
NAS_ORIGINAL_ROOT=/data/archive
NAS_PUBLIC_ROOT=/data/public
NAS_INCOMING_ROOT=/data/incoming
NAS_BACKUP_ROOT=/data/backups
MAX_UPLOAD_BYTES=1073741824
MAX_UPLOAD_CHUNK_BYTES=8388608
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
MAX_PDF_PAGES=5000
REQUIRE_CLOUD_FOR_PUBLICATION=false
ALLOW_LOCAL_PUBLIC_ASSET_ACCESS=true
X_ACCEL_REDIRECT_ENABLED=false
X_ACCEL_REDIRECT_PREFIX=/__protected_assets/
INTAKE_STORAGE_BACKEND=filesystem

# Private intake object storage
INTAKE_S3_ENDPOINT_URL=https://s3.example.com
INTAKE_S3_REGION=example-region-1
INTAKE_S3_BUCKET=social-theory-library-intake-example
INTAKE_S3_ACCESS_KEY_ID=
INTAKE_S3_SECRET_ACCESS_KEY=
INTAKE_S3_SESSION_TOKEN=
INTAKE_S3_PREFIX=incoming

# Public reading object storage
S3_ENABLED=false
S3_ENDPOINT_URL=https://s3.example.com
S3_REGION=example-region-1
S3_BUCKET=social-theory-library-public-example
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_PUBLIC_DOMAIN=library-assets.example.com
S3_SIGNED_URL_TTL_SECONDS=3600

# Meilisearch and semantic search
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=replace-with-a-random-meilisearch-master-key
USE_EXTERNAL_SEARCH=true
REQUIRE_EXTERNAL_SEARCH=false
SEMANTIC_SEARCH_ENABLED=true
THEORY_SYSTEM_ENABLED=true
SEMANTIC_SEARCH_PROVIDER=meilisearch
SEMANTIC_SEARCH_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_SEARCH_MODEL_REVISION=replace-with-a-pinned-model-revision
SEMANTIC_SEARCH_MODEL_POOLING=useModel
SEMANTIC_SEARCH_MODEL_CACHE=/models
SEMANTIC_SEARCH_OFFLINE_MODE=true
HF_ENDPOINT=https://huggingface.co
HF_HUB_OFFLINE=1
SEMANTIC_INDEX_STAGE_BATCH_SIZE=4
SEMANTIC_INDEX_DOCUMENT_BATCH_SIZE=128
SEMANTIC_INDEX_TASK_TIMEOUT_SECONDS=3600
SEMANTIC_INDEX_QUEUE_STALLED_SECONDS=300
SEMANTIC_INDEX_RUNNING_STALLED_SECONDS=1800
SEMANTIC_INDEX_RECOVERY_BATCH_SIZE=20
SEMANTIC_SEARCH_RERANKER=rules
SEMANTIC_SEARCH_RATIO=0.7
SEMANTIC_SEARCH_MAX_RESULTS_PER_WORK=3
SEMANTIC_SEARCH_QUERY_REWRITE_ENABLED=false
SEMANTIC_SEARCH_REQUIRED=false
SEMANTIC_SEARCH_INDEX_CONCURRENCY=1
SEMANTIC_EMBEDDING_API_KEY=
SEMANTIC_SEARCH_TIMEOUT_SECONDS=30
SEMANTIC_SEARCH_MAX_CONCURRENT=2
SEMANTIC_SEARCH_ANON_RATE=30/hour
SEMANTIC_SEARCH_USER_RATE=120/hour

# Viewpoint search V2 remains disabled until library-specific evaluation passes
SEMANTIC_SEARCH_V2_ENABLED=false
QUERY_LEXICON_SEARCH_CACHE_SECONDS=300
SEMANTIC_SEARCH_PROFILE=baseline
SEMANTIC_SEARCH_DENSE_TOP_K=40
SEMANTIC_SEARCH_SPARSE_TOP_K=40
SEMANTIC_SEARCH_FUSION_TOP_K=30
SEMANTIC_SEARCH_RERANK_TOP_K=20
SEMANTIC_SEARCH_FINAL_TOP_K=10
SEMANTIC_SEARCH_QUERY_EXPANSION_MAX=4
SEMANTIC_SEARCH_V2_MAX_MATCHED_ENTITIES=4
SEMANTIC_SEARCH_V2_MAX_TERMS_PER_ENTITY=4
SEMANTIC_SEARCH_V2_MAX_EXPANSION_CHARACTERS=600
SEMANTIC_SEARCH_V2_MAX_RECOGNITION_SPANS=512
SEMANTIC_SEARCH_V2_QUERY_EXPANSION_ENABLED=true
SEMANTIC_SEARCH_V2_RERANK_PROVIDER=rules
SEMANTIC_SEARCH_V2_RERANK_URL=
SEMANTIC_SEARCH_V2_RERANK_MODEL=replace-with-a-local-model-name
SEMANTIC_SEARCH_V2_RERANK_API_KEY=
SEMANTIC_SEARCH_V2_RERANK_ALLOWED_HOSTS=127.0.0.1,localhost
SEMANTIC_SEARCH_V2_RERANK_TIMEOUT_SECONDS=30
SEMANTIC_SEARCH_V2_RERANK_MAX_TEXT_CHARS=8000

# Optional AI candidate generation
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_METADATA_MODEL=
AI_CLASSIFIER_MODEL=
AI_VISION_MODEL=
AI_LIBRARY_MODEL=
AI_LIBRARY_TEMPERATURE=0.2
AI_LIBRARY_MAX_CONCURRENCY=1
AI_LIBRARY_MAX_OUTPUT_TOKENS=2000
AI_LIBRARY_MAX_OUTPUT_CHARS=12000
AI_TIMEOUT=30
AI_MAX_CONCURRENCY=1
AI_MAX_INPUT_CHARS=12000
LIBRARY_QA_RATE=30/hour
LIBRARY_QA_MAX_QUESTION_CHARS=4000
LIBRARY_QA_MAX_HISTORY_MESSAGES=8
LIBRARY_RAG_MAX_PASSAGES=8
LIBRARY_RAG_MAX_EVIDENCE_CHARS=9000
LIBRARY_RAG_PER_WORK_CAP=2
LIBRARY_RAG_COMPARISON_PER_ANCHOR=2
LIBRARY_RAG_MAX_ENTITY_BRANCHES=3
AI_ALLOWED_HOSTS=api.example.com
AI_AUTHORITY_RERANK_ENABLED=false

# Authority and bibliographic providers
AUTHORITY_PROVIDER_ENABLED=wikidata,viaf,loc,openalex
AUTHORITY_PROVIDER_ALLOWED_HOSTS=www.wikidata.org,query.wikidata.org,viaf.org,id.loc.gov,api.openalex.org
AUTHORITY_PROVIDER_TIMEOUT_SECONDS=8
AUTHORITY_PROVIDER_RETRIES=1
AUTHORITY_PROVIDER_MIN_INTERVAL_MS=200
AUTHORITY_PROVIDER_VERIFY_DNS=true
METADATA_PROVIDER_ENABLED=crossref,openalex,google_books
METADATA_PROVIDER_ALLOWED_HOSTS=api.crossref.org,api.openalex.org,www.googleapis.com
METADATA_PROVIDER_TIMEOUT_SECONDS=20
METADATA_PROVIDER_RETRIES=2
METADATA_PROVIDER_CACHE_SECONDS=86400
METADATA_PROVIDER_CIRCUIT_FAILURES=3
METADATA_PROVIDER_CIRCUIT_SECONDS=300
METADATA_PROVIDER_MIN_INTERVAL_MS=250
METADATA_PROVIDER_MAX_RESPONSE_BYTES=2097152
CROSSREF_MAILTO=metadata@example.com
OPENALEX_API_KEY=
GOOGLE_BOOKS_API_KEY=

# Field-aware enrichment. SearXNG is optional and no production service is
# enabled by this source setting alone. The configured search host is trusted
# infrastructure; every discovered source URL still passes SSRF checks.
FIELD_ENRICHMENT_WEB_SEARCH_ADAPTER=searxng
FIELD_ENRICHMENT_SEARXNG_URL=
FIELD_ENRICHMENT_SEARCH_ALLOWED_HOSTS=
FIELD_ENRICHMENT_SEARCH_TIMEOUT_SECONDS=8
FIELD_ENRICHMENT_SEARCH_RETRIES=1
FIELD_ENRICHMENT_SEARCH_MIN_INTERVAL_MS=200
FIELD_ENRICHMENT_SEARCH_MAX_BYTES=524288
FIELD_ENRICHMENT_SEARCH_CACHE_SECONDS=86400
FIELD_ENRICHMENT_FETCH_TIMEOUT_SECONDS=10
FIELD_ENRICHMENT_FETCH_RETRIES=1
FIELD_ENRICHMENT_FETCH_MAX_BYTES=1048576
FIELD_ENRICHMENT_FETCH_TEXT_CHARS=120000
FIELD_ENRICHMENT_FETCH_REDIRECT_LIMIT=3
FIELD_ENRICHMENT_FETCH_MIN_INTERVAL_MS=250
FIELD_ENRICHMENT_FETCH_CACHE_SECONDS=86400
FIELD_ENRICHMENT_MAX_SEARCH_QUERIES=8
FIELD_ENRICHMENT_SEARCH_RESULTS_PER_QUERY=5
FIELD_ENRICHMENT_MAX_FETCHED_DOCUMENTS=12

# OCR and document services
COMPOSE_PROFILES=ocr
PADDLEOCR_SERVICE_URL=http://paddleocr:8010
OCR_ENABLE_STRUCTURE=false
OCR_REMOTE_API_URL=
OCR_REMOTE_API_KEY=
OCR_REMOTE_MODEL=
OCR_REQUEST_TIMEOUT_SECONDS=1200
OCR_PAGE_BATCH_SIZE=4
OCR_REQUIRE_PERSISTENT_MODELS=true
OCR_REQUIRE_FALLBACK=false
OCR_REQUIRE_STRUCTURE=false
COVER_SCAN_MAX_PAGES=12
COVER_AUTO_SELECT_THRESHOLD=0.85
GROBID_SERVICE_URL=

# Request limits and authentication
API_ANON_RATE=120/hour
API_USER_RATE=1200/hour
EXACT_SEARCH_ANON_RATE=60/hour
EXACT_SEARCH_USER_RATE=240/hour
AUTH_LOGIN_RATE=20/hour
AUTH_REGISTER_RATE=10/hour
AUTH_PASSWORD_RESET_RATE=10/hour
AUTH_TOKEN_REFRESH_RATE=60/hour
JWT_ACCESS_COOKIE_NAME=stl_access
JWT_REFRESH_COOKIE_NAME=stl_refresh
JWT_BLACKLIST_AFTER_ROTATION=true
JWT_COOKIE_AUTH_ENABLED=true
JWT_RETURN_TOKENS_IN_BODY=false
PUBLIC_DEPLOYMENT_MODE=false
ANONYMOUS_EVENT_RETENTION_DAYS=30
PUBLIC_USAGE_EVENT_RATE=120/hour

# Transactional email
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=Social Theory Library
EMAIL_FROM_ADDRESS=no-reply@example.com
BREVO_API_KEY=
READER_SUBMISSION_EMAIL=submissions@example.com

# Optional network and scheduling values
CONTAINER_HTTP_PROXY=
CONTAINER_HTTPS_PROXY=
CONTAINER_NO_PROXY=127.0.0.1,localhost,postgres,redis,meilisearch,api,worker,ingestion-worker,beat,paddleocr,web,edge
GUNICORN_WORKERS=2
HEAVY_TASK_WINDOW_START=1
HEAVY_TASK_WINDOW_END=7
