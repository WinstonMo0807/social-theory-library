{
  "name": "social-theory-library-web",
  "version": "2.7.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-vinext-static-paths.mjs && node scripts/prepare-pdfjs-assets.mjs",
    "prebuild": "node scripts/patch-vinext-static-paths.mjs && node scripts/prepare-pdfjs-assets.mjs",
    "prestart": "node scripts/patch-vinext-static-paths.mjs && node scripts/prepare-pdfjs-assets.mjs",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test --test-force-exit tests/rendered-html.test.mjs tests/runtime-api.test.mjs tests/settings-controls.test.mjs tests/upload-metrics.test.mjs tests/reader-upload-layout.test.mjs tests/field-enrichment.test.mjs tests/library-rag.test.mjs tests/candidate-review.test.mjs tests/explore-redesign.test.mjs tests/metadata-inline-candidates.test.mjs && npm run test:auth",
    "test:e2e:public": "playwright test --config=playwright.public.config.ts",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.ts",
    "test:auth": "node --import tsx --test --test-force-exit tests/auth-session.test.mjs tests/scoped-search.test.mjs",
    "test:runtime-api": "node --experimental-strip-types --test --test-force-exit tests/runtime-api.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/pdfjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "cross-env": "^10.1.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "pdfjs-dist": "^5.4.530",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "0.0.50",
    "vite": "8.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
