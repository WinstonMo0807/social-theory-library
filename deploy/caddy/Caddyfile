{$LIBRARY_DOMAIN} {
    encode zstd gzip

    # Keep this direct gateway aligned with the Nginx preview allowlist.
    map {path} {library_frame_options} {library_frame_ancestors} {
        default DENY "'none'"
        ~^/(?:$|(?:about|explore|recommendations)/?$|recommendations/[^/]+/?$) SAMEORIGIN "'self'"
        ~^/(?:works|reader|subdisciplines)/[^/]+/?$ SAMEORIGIN "'self'"
        ~^/(?:scholars|topics|theory-schools)/[^/]+(?:/[^/]+)?/?$ SAMEORIGIN "'self'"
        ~^/theories/(?:nodes|disciplines|reading-paths)/[^/]+(?:/[^/]+)?/?$ SAMEORIGIN "'self'"
        ~^/admin/(?:preview/works/[^/]+|preview/(?:knowledge|evidence)/[^/]+/[^/]+|about/preview|recommendations/issues/[^/]+/preview)/?$ SAMEORIGIN "'self'"
    }

    header {
        -Server
        Strict-Transport-Security "{$PUBLIC_HSTS_HEADER:max-age=86400}"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "{library_frame_options}"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-site"
        X-Robots-Tag "{$PUBLIC_ROBOTS_HEADER:noindex, nofollow, noarchive}"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors {library_frame_ancestors}; frame-src 'self' blob:; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; worker-src 'self' blob:; media-src 'self' blob: https:"
    }

    reverse_proxy edge:80

    log {
        output file /var/log/caddy/access.json {
            roll_size 20MiB
            roll_keep 10
            roll_keep_for 720h
        }
        format json
    }
}
